# ── Host ──────────────────────────────────────────────
HOST_ADDRESS=0.0.0.0
WS_PORT=8765
DB_PATH=./syncro.db

# ── LLM (Ollama) ──────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_NUM_CTX=2048

# ── STT (faster-whisper) ──────────────────────────────
STT_MODEL_SIZE=small
STT_COMPUTE_TYPE=int8
STT_DEVICE=cpu

# ── TTS (Piper) ───────────────────────────────────────
PIPER_MODEL_PATH=./models/en_US-lessac-medium
TTS_SAMPLE_RATE=16000
TTS_CHUNK_MS=100

# ── openSMILE / affect (WP-104, not wired until W1) ───
OPENSMILE_EXECUTABLE=openSMILE
AFFECT_CLASSIFIER_PATH=./models/affect_classifier.pkl

# ── Policy (WP-103, not wired until W1) ───────────────
ADAPTIVE_LEAD_TIME_ENABLED=true
LEAD_TIME_DEFAULT=15
LEAD_TIME_MIN=5
LEAD_TIME_MAX=60
ALPHA=0.3
DEADLINE_PROXIMITY_HOURS=2
GRACE_WINDOW_MINUTES=15
SESSION_TIMEOUT_SECONDS=30

# ── OPEN ITEMS (SPEC §16) — placeholders, not confirmed values ─
REMINDER_RESPONSE_WINDOW_MINUTES=10
DELIVERY_FAILED_QUEUE_BOUND=20

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO